node_modules/
.env
session/
auth_state/
*.log
tmp/
prisma/*.db
.DS_Store
# Runtime state (games.json, economy.json …) is generated, but the vendored
# quiz banks are SOURCE: without them every quiz answers "bank is empty".
data/*
!data/quiz/
!data/quiz/*.json
sessions.json

# The standalone yt-dlp binary is fetched by scripts/fetch-ytdlp.cjs at install
# time. It is 41 MB and platform-specific, so it is never committed.
vendor/

# YouTube session cookies are credentials. Never commit them.
cookies.txt
*.cookies.txt
*.cookies
