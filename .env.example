# ZYNEX-MD — ALL OPTIONAL, no env vars needed!
# The bot works out of the box with zero configuration.
# Every user who pairs their WhatsApp is the owner of their own bot.

# ── IDENTITY (fork-ers: this is the only block you need) ───
# The name shown in chat, stickers, logos, packaging and the panel.
BOT_NAME=ZYNEX-MD
# Your name, as the bot shows it.
OWNER_NAME=ZYNEX
# Digits only: country code, no +, no leading 0.
OWNER_NUMBER=2348021016309
# Where your users pair. Must be your own deployment.
SITE_URL=https://zynex-md-production.up.railway.app
# Session-ID prefix this deployment accepts. Derived from BOT_NAME if unset.
SESSION_PREFIX=zynex-md

# ── DEVICE IDENTITY ────────────────────────────────────────
# What the bot claims to be to WhatsApp. Affects what it is sent: view-once
# media is NOT relayed to a Chrome/web identity, only to a phone identity.
#   chrome  (default) — safe, works with existing sessions
#   android           — presents ANDROID_PHONE; needs a FRESH pairing
#   desktop           — presents DESKTOP
# Changing this on a session that already paired will drop the link. The boot
# log says so before it happens.
DEVICE_IDENTITY=

# ── FFMPEG ─────────────────────────────────────────────────
# Leave empty to use the bundled ffmpeg-static binary (recommended).
# Set this only if your host already ships ffmpeg.
FFMPEG_PATH=

# ── FULL-LENGTH .play (yt-dlp) ──────────────────────────────
# `.play` tries YouTube, then SoundCloud (full 5-minute tracks, no auth),
# then the 30s Deezer/iTunes previews. Nothing below is required for the
# SoundCloud route. See PLAY.md for the full walkthrough.
#
# Skip YouTube entirely when your host IP is blocked (saves a few seconds):
#   youtube | soundcloud        (default: youtube then soundcloud)
YTDLP_AUDIO_SOURCE=
# Set to 0 to disable the SoundCloud fallback.
YTDLP_SOUNDCLOUD_FALLBACK=
#
# ── YouTube-only tracks: cookies ────────────────────────────
# Export a Netscape cookies.txt from a PRIVATE browser window logged into a
# SPARE Google account. Never use your main account. Never commit this file.
# Best for Railway/Render/Vercel: base64 it and paste the single line here.
#   Linux:  base64 -w0 cookies.txt
#   macOS:  base64 -i cookies.txt | tr -d '\n'
YTDLP_COOKIES_B64=
# ...or the raw Netscape text, or a path on a mounted volume:
YTDLP_COOKIES=
YTDLP_COOKIES_FILE=
#
# ── Advanced YouTube unblocking ─────────────────────────────
# bgutil PO-token provider (needs the plugin via YTDLP_PLUGIN_DIR with the
# standalone binary, or a pip-installed plugin):
YTDLP_POT_PROVIDER_URL=
YTDLP_PLUGIN_DIR=
# Player clients that are scored less harshly, e.g. mweb,tv,web_safari
YTDLP_PLAYER_CLIENT=
# Residential/mobile proxy when the datacentre IP itself is flagged:
YTDLP_PROXY=
# JS runtime for EJS challenges. Auto-detected: deno > bun > node.
# Set to 0 to disable, or e.g. "deno:/usr/bin/deno".
YTDLP_JS_RUNTIME=
# Force IPv4 (default on; set 0 to disable):
YTDLP_FORCE_IPV4=
# Fetch solver scripts if your yt-dlp build did not bundle them:
YTDLP_REMOTE_COMPONENTS=
# Raw extra flags, e.g. "--sleep-requests 1 --limit-rate 2M"
YTDLP_EXTRA_ARGS=
